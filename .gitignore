# Godot 4+ specific
.godot/
.import/
export.cfg
# export_presets.cfg is tracked on purpose: CI exports need it and ours
# contains no signing credentials.

# Local export output
build/
dist/

# Level-editor scratch artifacts. The real dev levels in dev_levels/*.lvl are
# tracked; these are regenerated on demand by the editor:
#   _selftest.lvl / _playtest.lvl — headless self-test + Playtest temp levels
#   _phase0.lvl                   — tests/phase0_test.tscn round-trip output
#   *_export.gd.txt               — GDScript-export copy/paste assist (not source)
#   *.bak                         — automatic campaign.json backups
dev_levels/_selftest.lvl
dev_levels/_playtest.lvl
dev_levels/_phase0.lvl
dev_levels/*_export.gd.txt
dev_levels/*.bak

# Capture-tool output (frame dumps, galleries, verification shots). The tools
# regenerate them on demand; at 3840x2400 they were 1.31 GiB of every checkout
# (#42). README gallery stills stay tracked at docs/screenshots/*.png, under
# the 3 MB budget tools/check_large_files.py enforces.
docs/screenshots/action/
docs/screenshots/boss/
docs/screenshots/boss_landing/
docs/screenshots/gunrange/
docs/screenshots/models/
docs/screenshots/objectives/
docs/screenshots/playtest/
docs/screenshots/weapon/

# Imported translations
*.translation

# Mono-specific
.mono/
data_*/
mono_crash.*.json

# System files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
.godot/

# Node / lat.md
node_modules/
# lat.md's scan cache. lat_init.json is tracked on purpose: it records the
# init version, and without it every `lat check` warns "No init version recorded".
lat.md/.cache/*
!lat.md/.cache/lat_init.json
# Blender iteration previews (tools/blender/fierce2.py)
tools/blender/preview_*
